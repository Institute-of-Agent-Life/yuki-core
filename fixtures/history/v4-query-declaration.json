{
  "source_commit": "329ca7c487414d2f54ddd98ff4727446ed2446cd",
  "tool": {
    "name": "query_chat_history",
    "description": "查询已观察到的聊天账本。recent 读取近期，search 按原文/本人语音、作者、日期或附件筛选，around 按内部 event_id 读取原会话邻文。target 省略时 recent 浏览当前会话，search 搜索所有获准的聊天。source可按平台及private/group筛选，与target取交集；recent仅给source时浏览该来源的会话集合。显式目标使用一个内部 ID，多入口合并检索并分别标明平台、私聊/群聊、会话名称与话题来源。可查重开上下文前的永久账本。target.person_id 选择私聊入口，顶层 person_id 筛选原作者。operation_id 沿原发送回执定位会话和原锚点。cursor 按 order 续查 ID 页；before/after 是 around 条数；around按锚点取邻文，不使用关键词、作者、日期、附件筛选。recent/search可用context_before/context_after附带各结果的邻文，默认不读；around只用before/after，按事件ID升序，不应用cursor/limit/order。日期未带时区按 UTC+8，起点包含、终点不含。不调用平台补查，不接受平台消息号。",
    "parameters": {
      "$defs": {
        "HistorySource": {
          "additionalProperties": false,
          "properties": {
            "platform": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Platform"
            },
            "scope": {
              "anyOf": [
                {
                  "enum": [
                    "private",
                    "group"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Scope"
            }
          },
          "title": "HistorySource",
          "type": "object"
        },
        "HistoryTarget": {
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "conversation_id"
              ]
            },
            {
              "required": [
                "person_id"
              ]
            },
            {
              "required": [
                "space_id"
              ]
            },
            {
              "required": [
                "binding_id"
              ]
            },
            {
              "required": [
                "operation_id"
              ]
            }
          ],
          "properties": {
            "conversation_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Conversation Id"
            },
            "person_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Person Id"
            },
            "space_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Space Id"
            },
            "binding_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Binding Id"
            },
            "operation_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Operation Id"
            }
          },
          "title": "HistoryTarget",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "view": {
          "default": "recent",
          "enum": [
            "recent",
            "search",
            "around"
          ],
          "title": "View",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistorySource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "order": {
          "default": "recent",
          "enum": [
            "recent",
            "oldest"
          ],
          "title": "Order",
          "type": "string"
        },
        "keyword": {
          "default": "",
          "title": "Keyword",
          "type": "string"
        },
        "match": {
          "default": "all",
          "enum": [
            "all",
            "any",
            "phrase"
          ],
          "title": "Match",
          "type": "string"
        },
        "exclude": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "person_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Person Id"
        },
        "author_kind": {
          "anyOf": [
            {
              "enum": [
                "person",
                "yuki",
                "external_bot",
                "system"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author Kind"
        },
        "event_kind": {
          "default": "message",
          "enum": [
            "message",
            "external_event",
            "all"
          ],
          "title": "Event Kind",
          "type": "string"
        },
        "start_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start At"
        },
        "end_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End At"
        },
        "has": {
          "default": [],
          "items": {
            "enum": [
              "image",
              "video",
              "file",
              "audio"
            ],
            "type": "string"
          },
          "title": "Has",
          "type": "array"
        },
        "limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "cursor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "event_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "before": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "context_before": {
          "default": 0,
          "minimum": 0,
          "title": "Context Before",
          "type": "integer"
        },
        "context_after": {
          "default": 0,
          "minimum": 0,
          "title": "Context After",
          "type": "integer"
        }
      },
      "title": "HistoryQuery",
      "type": "object"
    }
  }
}
