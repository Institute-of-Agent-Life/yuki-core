{
  "status": "candidate",
  "revision": 1,
  "methods": {
    "participation.sources": {
      "revision": 1,
      "direction": "plugin_to_host",
      "grant": "participation.sources",
      "params": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "after": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "entry"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "integer",
                  "minimum": 0
                },
                "preview": {
                  "type": "string",
                  "maxLength": 512
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "event",
                "preview",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "next": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "entry",
          "items",
          "next"
        ],
        "additionalProperties": false
      }
    },
    "participation.source": {
      "revision": 1,
      "direction": "plugin_to_host",
      "grant": "participation.source",
      "params": {
        "type": "object",
        "properties": {
          "event": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "include_origin": {
            "type": "boolean"
          },
          "include_reply": {
            "type": "boolean"
          },
          "include_self": {
            "type": "boolean"
          },
          "mention_cursor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "event"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "event": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "maxLength": 10924
          },
          "next": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "complete": {
            "type": "boolean"
          },
          "reply_to": {
            "type": ["object", "null"],
            "properties": {
              "event": { "type": "integer", "minimum": 1 },
              "version": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "required": ["event", "version"],
            "additionalProperties": false
          },
          "mentions": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": { "enum": ["member", "yuki", "all"] },
                    "display_name": { "type": "string", "maxLength": 128 },
                    "account_id": { "type": ["string", "null"] },
                    "assignment_id": { "type": ["string", "null"] },
                    "person_id": { "type": ["string", "null"] },
                    "presence_id": { "type": ["string", "null"] },
                    "text_start": { "type": ["integer", "null"], "minimum": 0 },
                    "text_end": { "type": ["integer", "null"], "minimum": 0 }
                  },
                  "required": ["kind", "display_name", "account_id", "assignment_id", "person_id", "presence_id", "text_start", "text_end"],
                  "additionalProperties": false
                }
              },
              "next": { "type": "integer", "minimum": 0 },
              "complete": { "type": "boolean" }
            },
            "required": ["items", "next", "complete"],
            "additionalProperties": false
          },
          "origin": {
            "type": "object",
            "properties": {
              "entry": { "type": "string" },
              "original_person": { "type": "string" },
              "actor_assignment": { "type": "string" },
              "current_person": { "type": "string" },
              "observed_generation": { "type": ["integer", "null"], "minimum": 1 },
              "current_generation": { "type": "integer", "minimum": 1 }
            },
            "required": [
              "entry",
              "original_person",
              "actor_assignment",
              "current_person",
              "observed_generation",
              "current_generation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "event",
          "version",
          "data",
          "next",
          "size",
          "complete"
        ],
        "additionalProperties": false
      }
    },
    "participation.promote": {
      "revision": 1,
      "direction": "plugin_to_host",
      "grant": "participation.promote",
      "params": {
        "type": "object",
        "properties": {
          "event": {
            "type": "integer",
            "minimum": 1
          },
          "expected_generation": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "event"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "event": {
            "type": "integer",
            "minimum": 0
          },
          "accepted": {
            "const": true
          },
          "newly_accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "event",
          "accepted",
          "newly_accepted"
        ],
        "additionalProperties": false
      }
    },
    "participation.self_propose": {
      "revision": 1,
      "direction": "plugin_to_host",
      "grant": "participation.self_propose",
      "params": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "entry",
          "key",
          "text"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "execution": {
            "type": "string"
          },
          "newly_accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "execution",
          "newly_accepted"
        ],
        "additionalProperties": false
      }
    },
    "participation.feedback": {
      "revision": 1,
      "direction": "plugin_to_host",
      "grant": "participation.feedback",
      "params": {
        "type": "object",
        "properties": {
          "event": {
            "type": "integer",
            "minimum": 1
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "event"
            ]
          },
          {
            "required": [
              "key"
            ]
          }
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "scope": {
            "const": "original_execution"
          },
          "executions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "execution": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "cancelled": {
                  "type": "boolean"
                },
                "quiet": {
                  "type": "boolean"
                },
                "sends": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "operation": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string"
                      },
                      "confirmed_parts": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "operation",
                      "state",
                      "confirmed_parts"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "execution",
                "state",
                "cancelled",
                "quiet",
                "sends"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "scope",
          "executions"
        ],
        "additionalProperties": false
      }
    }
  }
}
