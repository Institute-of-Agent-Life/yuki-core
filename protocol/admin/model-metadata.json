  "profile_schema": {
    "$defs": {
      "ChatWireOptions": {
        "additionalProperties": false,
        "properties": {
          "reasoning": {
            "default": "effort",
            "enum": [
              "effort",
              "thinking",
              "enable_thinking",
              "openrouter",
              "builtin",
              "gemini",
              "budget"
            ],
            "title": "Reasoning",
            "type": "string"
          },
          "token_field": {
            "default": "max_tokens",
            "enum": [
              "max_tokens",
              "max_completion_tokens"
            ],
            "title": "Token Field",
            "type": "string"
          },
          "send_temperature": {
            "default": false,
            "title": "Send Temperature",
            "type": "boolean"
          },
          "send_tool_choice": {
            "default": true,
            "title": "Send Tool Choice",
            "type": "boolean"
          },
          "replay_reasoning": {
            "default": true,
            "title": "Replay Reasoning",
            "type": "boolean"
          },
          "reasoning_split": {
            "default": false,
            "title": "Reasoning Split",
            "type": "boolean"
          },
          "send_reasoning_effort": {
            "default": false,
            "title": "Send Reasoning Effort",
            "type": "boolean"
          },
          "native_web_search": {
            "default": false,
            "title": "Native Web Search",
            "type": "boolean"
          },
          "thinking_budget_tokens": {
            "default": 4096,
            "minimum": 1024,
            "title": "Thinking Budget Tokens",
            "type": "integer"
          },
          "include_reasoning": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Include Reasoning"
          },
          "reasoning_format": {
            "anyOf": [
              {
                "enum": [
                  "parsed",
                  "hidden"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reasoning Format"
          }
        },
        "title": "ChatWireOptions",
        "type": "object"
      },
      "ModelCapability": {
        "description": "Features a profile must explicitly advertise.",
        "enum": [
          "tools",
          "structured_output",
          "reasoning",
          "long_context",
          "native_web_search",
          "image_input"
        ],
        "title": "ModelCapability",
        "type": "string"
      },
      "ModelProtocol": {
        "description": "Wire protocol used by one model profile.",
        "enum": [
          "chat_completions",
          "responses",
          "anthropic_messages",
          "gemini"
        ],
        "title": "ModelProtocol",
        "type": "string"
      },
      "ModelSearchMode": {
        "description": "Per-connection choice of provider and externally executed search.",
        "enum": [
          "external",
          "native",
          "both",
          "bridge"
        ],
        "title": "ModelSearchMode",
        "type": "string"
      },
      "ReasoningEffort": {
        "description": "Provider-neutral reasoning effort values used by Responses APIs.",
        "enum": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "title": "ReasoningEffort",
        "type": "string"
      },
      "StructuredOutputMode": {
        "description": "Supported provider strategies for one validated object.",
        "enum": [
          "function_tool",
          "json_schema",
          "text_json"
        ],
        "title": "StructuredOutputMode",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "One named provider endpoint and its defaults.",
    "properties": {
      "id": {
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.-]+$",
        "title": "Id",
        "type": "string"
      },
      "provider": {
        "minLength": 1,
        "title": "Provider",
        "type": "string"
      },
      "protocol": {
        "$ref": "#/$defs/ModelProtocol",
        "default": "chat_completions"
      },
      "base_url": {
        "default": "",
        "title": "Base Url",
        "type": "string"
      },
      "api_key_env": {
        "default": "",
        "title": "Api Key Env",
        "type": "string"
      },
      "model": {
        "minLength": 1,
        "title": "Model",
        "type": "string"
      },
      "timeout_seconds": {
        "exclusiveMinimum": 0,
        "title": "Timeout Seconds",
        "type": "number"
      },
      "max_retries": {
        "minimum": 0,
        "title": "Max Retries",
        "type": "integer"
      },
      "default_temperature": {
        "maximum": 2,
        "minimum": 0,
        "title": "Default Temperature",
        "type": "number"
      },
      "default_max_output_tokens": {
        "exclusiveMinimum": 0,
        "title": "Default Max Output Tokens",
        "type": "integer"
      },
      "max_output_tokens_limit": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Max Output Tokens Limit"
      },
      "max_input_tokens": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Max Input Tokens"
      },
      "context_window_tokens": {
        "anyOf": [
          {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Context Window Tokens"
      },
      "thinking_enabled": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": true,
        "title": "Thinking Enabled"
      },
      "reasoning_effort": {
        "anyOf": [
          {
            "$ref": "#/$defs/ReasoningEffort"
          },
          {
            "type": "null"
          }
        ],
        "default": "medium"
      },
      "structured_output_mode": {
        "$ref": "#/$defs/StructuredOutputMode",
        "default": "function_tool"
      },
      "search_mode": {
        "anyOf": [
          {
            "$ref": "#/$defs/ModelSearchMode"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "search_connection": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Search Connection"
      },
      "capabilities": {
        "default": [],
        "items": {
          "$ref": "#/$defs/ModelCapability"
        },
        "title": "Capabilities",
        "type": "array",
        "uniqueItems": true
      },
      "wire_options": {
        "anyOf": [
          {
            "$ref": "#/$defs/ChatWireOptions"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "headers": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Headers",
        "type": "object"
      }
    },
    "required": [
      "id",
      "provider",
      "model",
      "timeout_seconds",
      "max_retries",
      "default_temperature",
      "default_max_output_tokens"
    ],
    "title": "ModelProfile",
    "type": "object"
  },
